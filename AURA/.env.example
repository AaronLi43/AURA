# Copy this file to `.env` and fill in your own keys.
#
# The pipeline reads keys via python-dotenv from `NIPS_SUBMISSION_CODE/.env`
# (loaded by pipeline_config.py and run_expanded_privacy.py).
#
# OpenAI is required for the default mask/refill/attacker/keeper pipeline and
# for direct-intent web-search re-id.
OPENAI_API_KEY=sk-...

# OpenRouter is required if you set NB_LLM_PROVIDER=openrouter (e.g., for the
# Qwen on-device variants in run_qwen_expanded_batch.py).
OPENROUTER_API_KEY=sk-or-...

# Gemini is optional; only needed if the eval scripts are pointed at a Gemini
# judge in identifier_profile_preservation.py.
GEMINI_API_KEY=AIzaSy...
