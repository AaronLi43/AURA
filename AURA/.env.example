# Copy this file to `.env` and fill in your own keys.
#
# The pipeline reads keys via python-dotenv from `AURA/.env`
# (loaded by pipeline_config.py and run_expanded_privacy.py).
#
# OpenAI is required for the default mask/refill/attacker/keeper pipeline and
# for direct-intent web-search re-id.
OPENAI_API_KEY=sk-...

# OpenRouter is required when NB_LLM_PROVIDER=openrouter (Qwen rewrite runs).
OPENROUTER_API_KEY=sk-or-...

# Optional: switch the rewrite pipeline to OpenRouter (see README).
# NB_LLM_PROVIDER=openrouter
# NB_MASKER_MODEL=qwen/qwen3.5-27b
# NB_REFILLER_MODEL=qwen/qwen3.5-27b
# NB_ATTACKER_MODEL=qwen/qwen3.5-27b
# NB_KEEPER_MODEL=qwen/qwen3.5-27b
# NB_INIT_MODEL=qwen/qwen3.5-27b
# NB_MODULATOR_MODEL=qwen/qwen3.5-27b
# NB_DISABLE_REASONING=1

# Gemini is optional; only needed if the eval scripts are pointed at a Gemini
# judge in identifier_profile_preservation.py.
GEMINI_API_KEY=AIzaSy...
